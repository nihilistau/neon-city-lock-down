node_modules/*
# keep the tiny committed shim that re-exports vendor/three for Node tools/tests
!node_modules/three/
*.log
.DS_Store
Thumbs.db
# generated voice audio is committed; working temp files are not
assets/voice/_tmp/
# vendored Voxtral fork: source is committed, build output + model weights are not
# (scripts/voice/setup-voxtral.* builds/downloads them). ~2.7GB of weights.
third_party/voxtral/target/
third_party/voxtral/models/
# user-created content + saved/cloned voices (creation kit output)
user/
# LM Studio credentials — never commit. Copy lmstudio-api-key.example.txt and fill it in,
# or set the LMS_API_TOKEN env var instead (both paths fail soft when absent).
lmstudio-api-key*.txt
!lmstudio-api-key.example.txt
